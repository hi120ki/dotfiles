[user]
	email = 12624257+hi120ki@users.noreply.github.com
	name = Hi120ki
[ghq]
	root = ~/src
[init]
	defaultBranch = main
[core]
	editor = code --wait
	excludesfile = ~/.gitignore_global
[sequence]
	editor = code --wait
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# Machine-local settings (e.g. Secretive user.signingkey)
[include]
	path = ~/.gitconfig.local
